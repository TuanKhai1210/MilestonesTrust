# Default: real TideCloak authentication. Never silently falls back to demo identities.
AUTH_MODE=tidecloak
TIDECLOAK_CONFIG_PATH=./config/tidecloak.json
# Store only the PUBLIC client adapter export here. Never use a client secret.
# Node 24's built-in SQLite stores only synthetic campaign records.
DATABASE_PATH=./data/milestone-trust.sqlite
APP_ORIGIN=http://localhost:3000
# Read by the Security view. Set these after verifying in your realm, not as proof by themselves.
TIDECLOAK_REALM_ADMIN_COUNT=3
